{
  "name": "cosmocutie",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.14",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.13",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.15",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "supabase": "^2.114.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8083",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8083",
    "lint": "expo lint",
    "db:start": "supabase start -x vector,logflare,studio,imgproxy,edge-runtime,realtime,supavisor,mailpit",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db reset && docker exec -i supabase_db_CosmoCutie psql -U postgres -d postgres -q -v ON_ERROR_STOP=1 < supabase/tests/rls_seed.sql && docker exec -i supabase_db_CosmoCutie psql -U postgres -d postgres < supabase/tests/rls_test.sql",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "typecheck": "tsc --noEmit",
    "push:dev": "node scripts/check-env.mjs && eas update --branch development --message",
    "push:list": "eas update:list --branch development --limit 10",
    "push:preview": "node scripts/check-env.mjs && eas update --branch preview --message",
    "push:list:preview": "eas update:list --branch preview --limit 10",
    "build:preview": "eas build --profile preview --platform ios",
    "db:suite": "./scripts/run-suite.sh",
    "test:edge": "./scripts/test-edge.sh",
    "test:sig": "node --experimental-strip-types supabase/tests/webhook_signature_test.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "functions:serve:recorded": "supabase functions serve --env-file supabase/functions/.env.recorded",
    "test:shapes": "node supabase/tests/request_shape_test.mjs",
    "test:storage": "node supabase/tests/storage_e2e_test.mjs",
    "test:photos": "node --experimental-strip-types supabase/tests/resize_policy_test.ts",
    "test:export": "node supabase/tests/export_e2e_test.mjs"
  },
  "private": true
}
